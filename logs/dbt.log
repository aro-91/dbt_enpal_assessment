[0m20:52:02.177176 [debug] [Thread-1 (]: On model.enpal_assessment_project.int_activity: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "enpal_assessment_project", "target_name": "dev", "node_id": "model.enpal_assessment_project.int_activity"} */

  
    

  create  table "postgres"."public_pipedrive_analytics"."int_activity__dbt_tmp"
  
  
    as
  
  (
    

WITH 
sales_call_1 AS (
    SELECT 
        DATE_TRUNC('month', a.due_to::DATE) AS month,
        'Sales Call 1' AS kpi_name,
        2.1 AS funnel_step,
        COUNT(DISTINCT a.deal_id) AS deals_count
    FROM "postgres"."public_pipedrive_analytics"."stg_activity" a
    WHERE a.type = 'meeting'
    AND a.done = TRUE
    GROUP BY DATE_TRUNC('month', a.due_to::DATE)
),
sales_call_2 AS (
    SELECT 
        DATE_TRUNC('month', a.due_to::DATE) AS month,
        'Sales Call 2' AS kpi_name,
        3.1 AS funnel_step,
        COUNT(DISTINCT a.deal_id) AS deals_count
    FROM "postgres"."public_pipedrive_analytics"."stg_activity" a
    WHERE a.type = 'sc_2'
    AND a.done = TRUE
    GROUP BY DATE_TRUNC('month', a.due_to::DATE)
)

SELECT 
    month,
    kpi_name,
    funnel_step,
    deals_count
FROM sales_call_1
UNION ALL
SELECT 
    month,
    kpi_name,
    funnel_step,
    deals_count
FROM sales_call_2
  );
  
