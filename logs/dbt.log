        dateadd(day, seq4(), start_date) as the_date
    from (
        select dateadd(year, -5, current_date()) as start_date,
               dateadd(year, 5, current_date()) as end_date
    ),
    table(generator(rowcount => datediff(day, start_date, end_date)+1))
)

select
    the_date,
    to_char(the_date, 'YYYYMMDD')::int as date_key,
    year(the_date) as year,
    month(the_date) as month,
    day(the_date) as day,
    dayofweek(the_date) as day_of_week,          -- 1=Sunday, 7=Saturday
    dayofyear(the_date) as day_of_year,
    weekofyear(the_date) as week_of_year,
    is_weekend = case when dayofweek(the_date) in (1,7) then 1 else 0 end,
    to_char(the_date, 'MON') as month_abbrev,
    to_char(the_date, 'DY') as day_abbrev,
    to_char(the_date, 'YYYY-MM-DD') as date_formatted,
    to_number(to_char(the_date, 'IW')) as iso_week

from date_range
order by the_date
    )

