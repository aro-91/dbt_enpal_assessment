[0m14:10:26.946979 [debug] [Thread-2 (]: On model.pipedrive_dbt.int_deals_with_kpis: create or replace transient table pipedrive_analytics.intermediate.int_deals_with_kpis
    
    
    
    as (with deal_stage_history as (
    select * from pipedrive_analytics.intermediate.int_deal_stage_history
),
stages as (
    select * from pipedrive_analytics.staging.stg_stages
),
activity as (
    select * from pipedrive_analytics.staging.stg_activity
),
activity_types as (
    select * from pipedrive_analytics.staging.stg_activity_types
),
deals_with_kpis as (
    select
        dsh.deal_stage_change_id,
        dsh.deal_id,
        dsh.stage_id,
        s.stage_name,
        dsh.valid_from,
        case
            when s.stage_name = 'Lead Generation' then 'Step 1: Lead Generation'
            when s.stage_name = 'Qualified lead' then 'Step 2: Qualified Lead'
            when s.stage_name = 'Needs Assessment' then 'Step 3: Needs Assessment'
            when s.stage_name = 'Proposal/Quote Preparation' then 'Step 4: Proposal/Quote Preparation'
            when s.stage_name = 'Negotiation' then 'Step 5: Negotiation'
            when s.stage_name = 'Closing' then 'Step 6: Closing'
            when s.stage_name = 'Implementation/Onboarding' then 'Step 7: Implementation/Onboarding'
            when s.stage_name = 'Follow-up/Customer Success' then 'Step 8: Follow-up/Customer Success'
            when s.stage_name = 'Renewal/Expansion' then 'Step 9: Renewal/Expansion'
            else null
        end as funnel_step,
        case
            when s.stage_name = 'Qualified lead' and exists (
                select 1 from activity a
                join activity_types at on a.activity_type = at.activity_type_key
                where a.deal_id = dsh.deal_id
                and at.activity_name = 'Sales Call 1'
                and a.is_done
            ) then 'Step 2.1: Sales Call 1'
            when s.stage_name = 'Needs Assessment' and exists (
                select 1 from activity a
                join activity_types at on a.activity_type = at.activity_type_key
                where a.deal_id = dsh.deal_id
                and at.activity_name = 'Sales Call 2'
                and a.is_done
            ) then 'Step 3.1: Sales Call 2'
            else null
        end as sub_step
    from deal_stage_history dsh
    left join stages s on dsh.stage_id = s.stage_id
)
select * from deals_with_kpis
    )

