    as (with deal_stages as (

    select
        deal_id,
        cast(new_value as int) as stage_id,
        change_timestamp
    from pipedrive_analytics.staging.stg_deal_changes
    where changed_field_key = 'stage_id'

),

deal_stage_history as (
    select
        -- Create a unique key for each time a deal enters a stage
        md5(cast(coalesce(cast(deal_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(change_timestamp as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as deal_stage_change_id,
        deal_id,
        stage_id,
        change_timestamp as valid_from,
        lead(change_timestamp, 1) over (partition by deal_id order by change_timestamp) as valid_to,
        -- Add flags to identify forward or backward movement
        lag(stage_id, 1, 0) over (partition by deal_id order by change_timestamp) as previous_stage_id

    from deal_stages
)

select
    *,
    case
        when stage_id > previous_stage_id then 'Forward'
        when stage_id < previous_stage_id then 'Backward'
        else 'Stalled'
    end as movement_direction
from deal_stage_history
    )

