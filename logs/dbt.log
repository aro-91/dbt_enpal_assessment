unpivoted as (
    select
        deal_id,
        date_trunc('month', valid_from)::date as month,
        funnel_step as kpi_name,
        funnel_step
    from deals_with_kpis
    where funnel_step is not null

    union all

    select
        deal_id,
        date_trunc('month', valid_from)::date as month,
        sub_step as kpi_name,
        funnel_step
    from deals_with_kpis
    where sub_step is not null
),

final as (
    select
        month,
        kpi_name,
        funnel_step,
        count(distinct deal_id) as deals_count
    from unpivoted
    group by 1, 2, 3
)

select * from final
order by month, funnel_step
    )

