  create  table "postgres"."public_pipedrive_analytics"."int_deal_stage_progression__dbt_tmp"
  
  
    as
  
  (
    

with deal_stage_changes as (
    select
        deal_id,
        date_trunc('month', change_month)::date as month,
        
    case stage_id
        when '1' then 'Step 1: Lead Generation'
        when '2' then 'Step 2: Qualified Lead'
        when '3' then 'Step 3: Needs Assessment'
        when '4' then 'Step 4: Proposal/Quote Preparation'
        when '5' then 'Step 5: Negotiation'
        when '6' then 'Step 6: Closing'
        when '7' then 'Step 7: Implementation/Onboarding'
        when '8' then 'Step 8: Follow-up/Customer Success'
        when '9' then 'Step 9: Renewal/Expansion'
        else null
    end
 as funnel_step
    from "postgres"."public_pipedrive_analytics"."stg_stage_changes"
),

deal_activities as (
    select
        deal_id,
        date_trunc('month', due_date)::date as month,
        
    case type
        when 'meeting' then 'Step 2.1: Sales Call 1'
        when 'sc_2' then 'Step 3.1: Sales Call 2'
        when 'after_close_call' then 'Step 8: Follow-up/Customer Success'
        when 'follow_up' then 'Step 8: Follow-up/Customer Success'
        else null
    end
 as funnel_step
    from "postgres"."public_pipedrive_analytics"."stg_activity"
    where done = true
),

all_deal_events as (
    select * from deal_stage_changes
    union all
    select * from deal_activities
),

aggregated as (
    select
        month,
        funnel_step,
        count(distinct deal_id) as deals_count
    from all_deal_events
    group by 1,2
),

-- Funnel step reference for ordering
funnel_steps as (
    select * from (values
        ('1', 'Lead Generation'),
        ('2', 'Qualified Lead'),
        ('2.1', 'Sales Call 1'),
        ('3', 'Needs Assessment'),
        ('3.1', 'Sales Call 2'),
        ('4', 'Proposal/Quote Preparation'),
        ('5', 'Negotiation'),
        ('6', 'Closing'),
        ('7', 'Implementation/Onboarding'),
        ('8', 'Follow-up/Customer Success'),
        ('9', 'Renewal/Expansion')
    ) as t(step_number, funnel_step)
),

months as (
    select distinct month from aggregated
),

all_combinations as (
    select m.month, f.step_number, f.funnel_step
    from months m
    cross join funnel_steps f
)

select
    ac.month,
    ac.funnel_step,
    coalesce(a.deals_count, 0) as deals_count
from all_combinations ac
left join aggregated a
    on ac.month = a.month
    and ac.funnel_step = a.funnel_step
order by ac.month, ac.step_number
  );
  
