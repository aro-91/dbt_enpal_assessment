  create  table "postgres"."public_pipedrive_analytics"."dwh_deal_changes_activity__dbt_tmp"
  
  
    as
  
  (
    with deal_changes as (
    select 
        dc.deal_id::int as deal_id,
        dc.new_value::int as stage_id,
        st.stage_name as stage_name,
        change_time as change_time
    from "postgres"."public_pipedrive_analytics"."stg_deal_changes" dc 
    left join "postgres"."public_pipedrive_analytics"."stg_stages" st on dc.new_value::int = st.stage_id 
    where changed_field_key = 'stage_id'), 
calls_made as (
select 
    ac.deal_id as deal_id,
    case
        when ac.activity_type_code = 'meeting' then 2.1
        when ac.activity_type_code = 'sc_2' then 3.1 end as stage_id,
    ty.name as stage_name,
    ac.due_to as change_time
from "postgres"."public_pipedrive_analytics"."stg_activity" ac 
left join "postgres"."public_pipedrive_analytics"."stg_activity_types" ty on ac.type = ty.type
where (ac.activity_type_code = 'sc_2' OR ac.type = 'meeting') and done = true)
select * from deal_changes
union
select * from calls_made
  );
  
