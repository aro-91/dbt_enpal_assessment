    as (with deals_with_kpis as (
    select * from pipedrive_analytics.intermediate.int_deals_with_kpis 
),
unpivoted as (
    select
        deal_stage_change_id, -- Use the new unique ID
        date_trunc('month', valid_from)::date as month,
        funnel_step as kpi_name,
        funnel_step,
        movement_direction -- We can now analyze the direction of movement
    from deals_with_kpis
    where funnel_step is not null
    union all
    select
        deal_stage_change_id,
        date_trunc('month', valid_from)::date as month,
        sub_step as kpi_name,
        funnel_step,
        movement_direction
    from deals_with_kpis
    where sub_step is not null
),
final as (
    select
        month,
        kpi_name,
        funnel_step,
        movement_direction,
        -- The core change: count the unique events, not the deals
        count(deal_stage_change_id) as deals_entered_stage_count
    from unpivoted
    group by 1, 2, 3, 4
)
select * from final
order by month, funnel_step
    )

